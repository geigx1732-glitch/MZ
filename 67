-- ============ ⏰ Countdown Display ============
local countdownLabel = Instance.new("TextLabel", SG)
countdownLabel.Size = UDim2.new(0, 300, 0, 50)
countdownLabel.Position = UDim2.new(0.5, -150, 0, 20)
countdownLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
