    "🫠", "😵", "💩", "🎭", "🍕", "🐔"
}

local function StartEmojiLoop()
    if emojiLoopRunning then return end
    emojiLoopRunning = true

    task.spawn(function()
        while emojiLoopRunning do
            local emoji = Instance.new("TextLabel", SG)
            local size = math.random(50, 120)
            emoji.Size = UDim2.new(0, size, 0, size)
            emoji.Position = UDim2.new(
                math.random(0, 95) / 100, 0,
                math.random(0, 95) / 100, 0
            )
            emoji.BackgroundTransparency = 1
            emoji.Text = emojiList[math.random(1, #emojiList)]
            emoji.TextSize = size
            emoji.Font = Enum.Font.SourceSansBold
            emoji.TextStrokeTransparency = 0
            emoji.Rotation = math.random(-45, 45)
            emoji.ZIndex = 99
            table.insert(texts, emoji)

            task.spawn(function()
                local sy = emoji.Position.Y.Scale
                local sr = emoji.Rotation
                local ut = 0
                while ut < 2 and emoji.Parent do
                    ut = ut + 0.05
                    emoji.Position = UDim2.new(
                        emoji.Position.X.Scale, 0,
                        sy - ut * 0.15, 0
                    )
                    emoji.Rotation = sr + ut * 40
                    emoji.TextTransparency = ut / 2
                    task.wait(0.05)
                end
                if emoji.Parent then emoji:Destroy() end
            end)

            task.wait(0.15)
        end
    end)
end

local function StopEmojiLoop()
    emojiLoopRunning = false
    for _, v in ipairs(texts) do
        pcall(function() v:Destroy() end)
    end
    texts = {}
end

-- ============ Start Prank ============
local function StartPrank()
    prankActive = true
    conns = {}
    texts = {}
    originCam = CM.CFrame
    originFov = CM.FieldOfView

    -- 1. จอแดง
    local red = Instance.new("Frame", SG)
    red.Size = UDim2.new(1, 0, 1, 0)
    red.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    red.BackgroundTransparency = 0.7
    red.BorderSizePixel = 0
    red.ZIndex = 50

    -- 2. จอเขียว
    local green = Instance.new("Frame", SG)
    green.Size = UDim2.new(1, 0, 1, 0)
    green.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    green.BackgroundTransparency = 0.85
    green.BorderSizePixel = 0
    green.ZIndex = 49

    local t = 0
    table.insert(conns, R.Heartbeat:Connect(function(dt)
        if not prankActive then return end
        t = t + dt
        red.BackgroundTransparency = 0.3 + math.sin(t * 20) * 0.4
        green.BackgroundTransparency = 0.5 + math.cos(t * 15) * 0.4
    end))

    -- 3. กล้องวาป
    local camT = 0
    table.insert(conns, R.RenderStepped:Connect(function(dt)
        if not prankActive then return end
        camT = camT + dt
        if math.floor(camT * 7) % 2 == 0 then
            CM.CFrame = originCam * CFrame.new(
                math.random(-150, 150) / 10,
                math.random(-150, 150) / 10,
                math.random(-150, 150) / 10
            ) * CFrame.Angles(
                math.random(-30, 30) / 100,
                math.random(-30, 30) / 100,
                math.sin(camT * 3) * 0.3
            )
        else
            CM.CFrame = originCam
        end
        CM.FieldOfView = 70 + math.sin(camT * 10) * 25
    end))

    -- 4. ข้อความกลาง
    local msg = Instance.new("TextLabel", SG)
    msg.Size = UDim2.new(1, 0, 0, 200)
    msg.Position = UDim2.new(0, 0, 0.4, -100)
    msg.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    msg.BackgroundTransparency = 0.3
    msg.Text = "🚨 โดนแฮ็ก! 🚨\nเล่นโปรทำไม?"
    msg.TextColor3 = Color3.fromRGB(255, 255, 255)
    msg.TextSize = 55
    msg.Font = Enum.Font.SourceSansBold
    msg.TextStrokeTransparency = 0
    msg.ZIndex = 100
    table.insert(texts, msg)

    local mt = 0
    table.insert(conns, R.Heartbeat:Connect(function(dt)
        if not prankActive or not msg.Parent then return end
        mt = mt + dt
        msg.TextTransparency = math.abs(math.sin(mt * 12))
        msg.Rotation = math.sin(mt * 6) * 15
        msg.BackgroundColor3 = Color3.fromRGB(
            math.random(150, 255),
            math.random(0, 80),
            math.random(0, 80)
        )
        msg.TextSize = 55 + math.sin(mt * 10) * 8
    end))

    -- 5. Emoji Loop
    StartEmojiLoop()

    -- 6. เสียงบี๊บ
    for i = 1, 300 do
        task.delay((i - 1) * 0.25, function()
            if not prankActive then return end
            local s = Instance.new("Sound", SS)
            s.SoundId = "rbxassetid://9120386436"
            s.Volume = 3
            s.PlaybackSpeed = math.random(50, 200) / 100
            s:Play()
            task.delay(1, function() s:Destroy() end)
        end)
    end

    -- 7. ตัวละครวาป
    table.insert(conns, R.Heartbeat:Connect(function()
        if not prankActive then return end
        local ch = LP.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if math.random(1, 5) == 1 then
            hrp.CFrame = hrp.CFrame * CFrame.new(
                math.random(-40, 40),
                math.random(-10, 15),
                math.random(-40, 40)
            )
        end
    end))

    -- 8. Blur
    pcall(function()
        local b = L:FindFirstChild("MZ_Blur")
        if not b then
            b = Instance.new("BlurEffect", L)
            b.Name = "MZ_Blur"
        end
        b.Size = 0
        table.insert(conns, R.Heartbeat:Connect(function()
            if not prankActive then return end
            b.Size = 4 + math.sin(tick() * 8) * 4
        end))
        conns._blur = b
    end)

    -- 9. ColorCorrection
    pcall(function()
        local c = L:FindFirstChild("MZ_CC")
        if not c then
            c = Instance.new("ColorCorrectionEffect", L)
            c.Name = "MZ_CC"
        end
        table.insert(conns, R.Heartbeat:Connect(function()
            if not prankActive then return end
            c.TintColor = Color3.fromRGB(
                math.random(150, 255),
                math.random(100, 255),
                math.random(100, 255)
            )
        end))
        conns._cc = c
    end)

    conns._red = red
    conns._green = green
    conns._msg = msg
end

-- ============ Stop Prank ============
local function StopPrank()
    prankActive = false
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    if conns._red then pcall(function() conns._red:Destroy() end) end
    if conns._green then pcall(function() conns._green:Destroy() end) end
    if conns._msg then pcall(function() conns._msg:Destroy() end) end
    if conns._blur then pcall(function() conns._blur:Destroy() end) end
    if conns._cc then pcall(function() conns._cc:Destroy() end) end
    if originCam then CM.CFrame = originCam end
    if originFov then CM.FieldOfView = originFov end

    StopEmojiLoop()
    countdownLabel.Visible = false

    conns = {}
end

