local cdst = Instance.new("UIStroke", countdownLabel)
cdst.Color = Color3.fromRGB(255, 50, 50)
cdst.Thickness = 2

local function UpdateCountdown(secondsLeft)
    countdownLabel.Visible = true
    task.spawn(function()
        while secondsLeft > 0 and prankActive do
            local h = math.floor(secondsLeft / 3600)
            local m = math.floor((secondsLeft % 3600) / 60)
            local s = secondsLeft % 60
            countdownLabel.Text = string.format("⏰ %02d:%02d:%02d", h, m, s)
            task.wait(1)
            secondsLeft = secondsLeft - 1
        end
        countdownLabel.Visible = false
    end)
end

-- ============ 🔒 บล็อคออกเกม ============
local function BlockLeave()
    if not BLOCK_LEAVE then return end
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
    pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)
    pcall(function() StarterGui:SetCore("ResetButtonCallback", false) end)

    table.insert(conns, U.InputBegan:Connect(function(input)
        if BLOCK_LEAVE and input.KeyCode == Enum.KeyCode.Escape then
            pcall(function() StarterGui:SetCore("ResetButtonCallback", false) end)
        end
    end))

    pcall(function()
        table.insert(conns, GS.MenuOpened:Connect(function()
            if BLOCK_LEAVE then
                task.wait(0.05)
                pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
            end
        end))
    end)

    task.spawn(function()
        while BLOCK_LEAVE do
            task.wait(0.05)
            pcall(function()
                if GS:GetMenuIsOpen() then GS:SetMenuIsOpen(false) end
            end)
        end
    end)
end

local function UnblockLeave()
    BLOCK_LEAVE = false
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
        StarterGui:SetCore("TopbarEnabled", true)
        StarterGui:SetCore("ResetButtonCallback", true)
    end)
end

